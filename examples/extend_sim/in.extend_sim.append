# extend_sim example 1: append copies of a sample onto the LIVE system
#
# A periodic box is grown with change_box and 3 more copies of the
# starting cell are stacked on top.  No restart, no dynamics.

units        lj
atom_style   atomic
boundary     p p p

lattice      fcc 0.8442
region       box block 0 5 0 5 0 8
create_box   1 box
create_atoms 1 box
mass         1 1.0

pair_style   lj/cut 2.5
pair_coeff   1 1 1.0 1.0

# write the current cell out as the reference sample
write_data   sample.data nocoeff

# grow +z and stack 3 copies -> 4x atoms, box z: L -> 4L
extend_sim   init sample.data axis z nreplica 3

thermo       10
run          0
write_dump   all atom append.lammpstrj
