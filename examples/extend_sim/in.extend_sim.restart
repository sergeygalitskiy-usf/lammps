# extend_sim example 2: load a RESTART, then append copies of a sample
#
# The first block builds a base.restart + a matching sample.data once.
# The second block clears the system and rebuilds it, extended, from
# the restart file via the 'restart' keyword.

units        lj
atom_style   atomic
boundary     p p p

# ---- build base.restart and sample.data ----
lattice      fcc 0.8442
region       box block 0 5 0 5 0 8
create_box   1 box
create_atoms 1 box
mass         1 1.0
pair_style   lj/cut 2.5
pair_coeff   1 1 1.0 1.0
write_restart base.restart
write_data    sample.data nocoeff

clear                       # 'restart' path requires no existing box

# ---- rebuild from the restart, extended by 2 slabs ----
extend_sim   restart base.restart init sample.data axis z nreplica 2

thermo       10
run          0
write_dump   all atom restart_extended.lammpstrj
